{
  "name": "vipshop-ecommerce",
  "version": "2.0.0",
  "type": "module",
  "description": "vipshop-ecommerce is a production-oriented e-commerce transaction platform focused on order workflow, payment verification, inventory coordination, and refund handling.",
  "main": "backend/server.ts",
  "scripts": {
    "start": "node --loader tsx backend/server.ts",
    "server": "nodemon --exec \"node --loader tsx\" backend/server.ts",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node --loader tsx backend/seeder.ts",
    "data:destroy": "node --loader tsx backend/seeder.ts -d",
    "build": "npm install && npm install --prefix frontend && npm run build --prefix frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "npm run typecheck:root && npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "typecheck:backend": "tsc -p backend/tsconfig.json --noEmit",
    "typecheck:frontend": "tsc -p frontend/tsconfig.json --noEmit",
    "generate-toc": "markdown-toc -i readme.md"
  },
  "author": "Brad Traversy",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "redis": "^5.12.1",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.1",
    "concurrently": "^7.6.0",
    "jsdom": "^29.1.0",
    "markdown-toc": "^1.2.0",
    "nodemon": "^2.0.21",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
