# Runtime
NODE_ENV=development
APP_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://mongo:27017/vipshop
REDIS_URL=redis://redis:6379

# Authentication
JWT_SECRET=change_me
JWT_EXPIRES_IN=30d

# PayPal
PAYPAL_CLIENT_ID=change_me
PAYPAL_APP_SECRET=change_me
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# Frontend API base URLs
# Local development (non-Docker) typically uses the backend running on localhost.
VITE_API_BASE_URL=http://localhost:5000
STAGING_API_BASE_URL=http://localhost:5000
PROD_API_BASE_URL=http://localhost:5000

# Optional app metadata
APP_NAME=vipshop-ecommerce
